{
  "name": "Kratos Layout Dev Container",
  "dockerFile": "../Dockerfile",
  "build": {
    "context": "..",
    "args": {
      "UBUNTU_VERSION": "ubuntu24.04",
      "CLAUDE_CODE_VERSION": "1.x"
    }
  },
  "containerEnv": {
    "TZ": "Asia/Shanghai",
    "LANG": "zh_CN.UTF-8",
    "LC_ALL": "zh_CN.UTF-8",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "ANTHROPIC_BASE_URL": "${env:ANTHROPIC_BASE_URL}",
    "ANTHROPIC_MODEL": "${env:ANTHROPIC_MODEL}",
    "ANTHROPIC_SMALL_FAST_MODEL": "${env:ANTHROPIC_SMALL_FAST_MODEL}",
    "ANTHROPIC_API_KEY": "${env:ANTHROPIC_API_KEY}",
    "ANTHROPIC_AUTH_TOKEN": "${env:ANTHROPIC_AUTH_TOKEN}"
  },
  "workspaceFolder": "/development/github.com/fsyyft-go/kratos-layout",
  "workspaceMount": "source=${localWorkspaceFolder},target=/development/github.com/fsyyft-go/kratos-layout,type=bind",
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=${localWorkspaceFolder}/.devcontainer/data/go/cache,target=/usr/local/go/cache,type=bind",
    "source=${localWorkspaceFolder}/.devcontainer/data/go/path,target=/usr/local/go/path,type=bind"
  ],
  "portsAttributes": {
    "22": {
      "label": "SSH",
      "onAutoForward": "silent"
    },
    "8000": {
      "label": "Web Server",
      "onAutoForward": "openPreview"
    },
    "8001": {
      "label": "Task Server",
      "onAutoForward": "silent"
    },
    "9000": {
      "label": "gRPC Server",
      "onAutoForward": "silent"
    }
  },
  "remoteUser": "fsyyft",
  "runArgs": [
    "--pull",
    "never",
    "--name",
    "dev-kratos-layout",
    "--cap-add=SYS_PTRACE",
    "--security-opt",
    "seccomp=unconfined",
    "--hostname",
    "kratos-dev"
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.fontSize": 14,
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.organizeImports": "explicit"
        },
        "go.toolsManagement.checkForUpdates": "local",
        "go.useLanguageServer": true,
        "go.goroot": "/usr/local/go",
        "go.gopath": "/go",
        "files.eol": "\n",
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true
      },
      "extensions": [
        "golang.go",
        "ms-vscode.makefile-tools",
        "eamodio.gitlens",
        "GitHub.copilot",
        "anthropic.claude-code"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "onCreateCommand": "",
  "postCreateCommand": "",
  "forwardPorts": [
    8000,
    8001,
    9000
  ],
  "otherPortsAttributes": {
    "onAutoForward": "silent"
  }
}
