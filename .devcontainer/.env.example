# ==================== 构建时使用的环境变量 ====================
# 这些变量仅在 Docker 镜像构建时使用。

# Ubuntu 版本号（用于构建镜像）。
UBUNTU_VERSION=ubuntu24.04

# Claude Code 版本（默认为 latest）。
# 可使用具体版本号（如 2.1.12）或 latest。
CLAUDE_CODE_VERSION=latest

# Gemini CLI 版本（默认为 latest）。
# 可使用具体版本号（如 0.24.4）或 latest。
GEMINI_VERSION=latest

# Qwen Code 版本（默认为 latest）。
# 可使用具体版本号（如 0.7.1）或 latest。
QWEN_VERSION=latest

# OpenAI CodeX 版本（默认为 latest）。
# 可使用具体版本号（如 0.87.0）或 latest。
CODEX_VERSION=latest

# OpenSpec 版本（默认为 latest）。
# 可使用具体版本号（如 0.21.0）或 latest。
OPENSPEC_VERSION=latest

# Tencent CodeBuddy 版本（默认为 latest）。
# 可使用具体版本号（如 2.37.2）或 latest。
CODEBUDDY_VERSION=latest

# Go 语言版本。
GO_VERSION=1.25

# ==================== 运行时使用的环境变量 ====================
# 这些变量在容器运行时使用（可根据需要添加）。

# 容器名称前缀（用于 docker run --name 参数）。
CONTAINER_NAME_PREFIX=quicktest

# SSH 端口映射（用于 docker run -p 参数，格式：主机端口:容器端口）。
SSH_PORT_MAPPING=44422:22

# Anthropic 日志级别（用于调试和问题排查）。
# 可选值：
#   - debug:   显示详细的 API 请求日志，包括请求耗时、响应状态等（用于诊断慢请求或失败）
#   - info:    显示基本信息级别的日志
#   - warn:    仅显示警告和错误信息
#   - error:   仅显示错误信息
#   - (未设置): 不输出调试日志
# 用法示例：export ANTHROPIC_LOG=debug
# ANTHROPIC_LOG=debug

# Anthropic API 基础 URL（用于 AI 代码助手调用）。
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic

# Anthropic 主要模型名称（用于复杂任务）。
ANTHROPIC_MODEL=glm-4.7

# Anthropic 轻量快速模型名称（用于简单任务）。
ANTHROPIC_SMALL_FAST_MODEL=glm-4.7

# Anthropic 认证令牌（用于 API 身份验证）。
ANTHROPIC_AUTH_TOKEN=

# Anthropic API 密钥（用于 API 访问）。
ANTHROPIC_API_KEY=