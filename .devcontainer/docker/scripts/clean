#!/bin/bash

# Docker 镜像清理脚本
# 用于清理开发环境的 Docker 镜像
#
# 使用方法：
#   ./clean all          # 清理所有当前镜像的不同版本
#   ./clean keep-latest  # 清理当前镜像的除最后一个版本外的所有版本
#   ./clean keep-daily   # 清理当前镜像的不同天版本，每天只留最后一个
#   ./clean --help       # 显示帮助信息

set -e

# 项目配置
IMAGE_REPO="fsyyft/devcontainer/ubuntu/go"

# 切换到脚本所在目录
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# 颜色输出
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# 日志函数
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

# 显示帮助信息
show_help() {
    echo "Docker 镜像清理脚本"
    echo
    echo "用法："
    echo "  $0 <命令> [选项]"
    echo
    echo "命令："
    echo "  all          清理所有当前镜像的不同版本"
    echo "  keep-latest  清理当前镜像的除最后一个版本外的所有版本"
    echo "  keep-daily   清理当前镜像的不同天版本，每天只留最后一个"
    echo "  --help       显示此帮助信息"
    echo
    echo "示例："
    echo "  $0 all          # 删除所有 ${IMAGE_REPO} 相关的镜像"
    echo "  $0 keep-latest  # 只保留最新的镜像版本"
    echo "  $0 keep-daily   # 每天只保留最新的镜像版本"
    echo
    echo "注意："
    echo "  - 清理操作不可逆，请谨慎使用"
    echo "  - 建议在清理前备份重要数据"
    echo "  - latest 标签不会被删除（除非使用 all 命令）"
}

# 检查 Docker 是否安装和运行
check_docker() {
    if ! command -v docker &> /dev/null; then
        log_error "Docker 未安装。请先安装 Docker。"
        exit 1
    fi

    if ! docker info &> /dev/null; then
        log_error "Docker 未运行或无权限访问。"
        exit 1
    fi
}

# 获取所有相关镜像
get_related_images() {
    docker images --format "{{.Repository}}:{{.Tag}} {{.ID}}" | grep "^${IMAGE_REPO}:" | sort -V
}

# 解析镜像标签中的日期和序号
parse_tag() {
    local tag="$1"
    # 标签格式: YYMMDDNN (例如: 24101401)
    # YYMMDD - 日期, NN - 序号
    local date_part="${tag:0:6}"
    local counter_part="${tag:6:2}"

    echo "$date_part $counter_part"
}

# 清理所有镜像
clean_all() {
    log_info "开始清理所有 ${IMAGE_REPO} 相关的镜像..."

    local images=$(get_related_images)
    if [ -z "$images" ]; then
        log_info "没有找到相关的镜像，无需清理。"
        return 0
    fi

    echo "将要删除以下镜像："
    echo "$images" | while read -r line; do
        local image_name=$(echo "$line" | awk '{print $1}')
        local image_id=$(echo "$line" | awk '{print $2}')
        echo "  - $image_name ($image_id)"
    done

    echo
    read -p "确认删除以上镜像？(y/N): " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        log_info "操作已取消。"
        return 0
    fi

    local deleted_count=0
    while read -r line; do
        local image_name=$(echo "$line" | awk '{print $1}')
        local image_id=$(echo "$line" | awk '{print $2}')

        log_info "删除镜像: $image_name"
        if docker rmi "$image_name" 2>/dev/null; then
            ((deleted_count++))
        else
            log_warn "删除失败: $image_name"
        fi
    done < <(echo "$images")

    log_success "清理完成，共删除 $deleted_count 个镜像。"
}

# 保留最新版本
clean_keep_latest() {
    log_info "开始清理镜像，保留最新版本..."

    local images=$(get_related_images)
    if [ -z "$images" ]; then
        log_info "没有找到相关的镜像，无需清理。"
        return 0
    fi

    # 找到所有非 latest 标签的镜像，按版本号排序
    local versioned_images=$(echo "$images" | grep -v ":latest " | sort -V)

    if [ -z "$versioned_images" ]; then
        log_info "没有找到版本化标签的镜像。"
        return 0
    fi

    # 获取最新版本的镜像（排序后最后一个）
    local latest_line=$(echo "$versioned_images" | tail -n 1)
    local latest_image=$(echo "$latest_line" | awk '{print $1}')
    local latest_id=$(echo "$latest_line" | awk '{print $2}')

    log_info "保留最新镜像: $latest_image ($latest_id)"

    # 获取要删除的镜像（所有非 latest 标签且不是最新版本的镜像）
    local images_to_delete=$(echo "$versioned_images" | sed '$d')

    if [ -z "$images_to_delete" ]; then
        log_info "没有需要清理的镜像。"
        return 0
    fi

    echo "将要删除以下镜像："
    echo "$images_to_delete" | while read -r line; do
        local image_name=$(echo "$line" | awk '{print $1}')
        local image_id=$(echo "$line" | awk '{print $2}')
        echo "  - $image_name ($image_id)"
    done

    echo
    read -p "确认删除以上镜像？(y/N): " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        log_info "操作已取消。"
        return 0
    fi

    local deleted_count=0
    while read -r line; do
        local image_name=$(echo "$line" | awk '{print $1}')
        local image_id=$(echo "$line" | awk '{print $2}')

        log_info "删除镜像: $image_name"
        if docker rmi "$image_name" 2>/dev/null; then
            ((deleted_count++))
        else
            log_warn "删除失败: $image_name"
        fi
    done < <(echo "$images_to_delete")

    log_success "清理完成，共删除 $deleted_count 个镜像。"
}

# 保留每天的最新版本
clean_keep_daily() {
    log_info "开始清理镜像，保留每天的最新版本..."

    local images=$(get_related_images)
    if [ -z "$images" ]; then
        log_info "没有找到相关的镜像，无需清理。"
        return 0
    fi

    # 按日期分组，保留每组的最新镜像
    local images_by_date=$(echo "$images" | grep -v ":latest$" | while read -r line; do
        local image_name=$(echo "$line" | awk '{print $1}')
        local image_id=$(echo "$line" | awk '{print $2}')
        local tag=$(echo "$image_name" | sed "s#${IMAGE_REPO}:##")

        # 解析日期部分 (YYMMDD)
        local date_part="${tag:0:6}"
        echo "$date_part $tag $image_name $image_id"
    done | sort -k1,1 -k2,2V | awk '
        $1 != prev_date {
            if (prev_date != "") {
                print latest_line
            }
            prev_date = $1
            latest_line = $0
        }
        {
            latest_line = $0
        }
        END {
            if (prev_date != "") {
                print latest_line
            }
        }
    ')

    # 获取要保留的镜像
    local images_to_keep=$(echo "$images_by_date" | awk '{print $3}' | sort -u)

    # 添加 latest 标签镜像（如果存在）
    local latest_image=$(echo "$images" | grep ":latest$" | awk '{print $1}' || true)
    if [ -n "$latest_image" ]; then
        images_to_keep="$images_to_keep"$'\n'"$latest_image"
    fi

    # 获取所有镜像
    local all_images=$(echo "$images" | awk '{print $1}')

    # 计算要删除的镜像
    local images_to_delete=""
    for image in $all_images; do
        if ! echo "$images_to_keep" | grep -q "^$image$"; then
            images_to_delete="$images_to_delete"$'\n'"$image"
        fi
    done
    images_to_delete=$(echo "$images_to_delete" | sed '/^$/d')

    if [ -z "$images_to_delete" ]; then
        log_info "没有需要清理的镜像。"
        return 0
    fi

    echo "将要保留的镜像："
    echo "$images_to_keep" | while read -r image_name; do
        local image_info=$(echo "$images" | grep "^$image_name " | awk '{print $1 " (" $2 ")"}')
        echo "  + $image_info"
    done

    echo
    echo "将要删除的镜像："
    echo "$images_to_delete" | while read -r image_name; do
        local image_info=$(echo "$images" | grep "^$image_name " | awk '{print $1 " (" $2 ")"}')
        echo "  - $image_info"
    done

    echo
    read -p "确认删除以上镜像？(y/N): " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        log_info "操作已取消。"
        return 0
    fi

    local deleted_count=0
    while read -r image_name; do
        local image_id=$(echo "$images" | grep "^$image_name " | awk '{print $2}')

        log_info "删除镜像: $image_name"
        if docker rmi "$image_name" 2>/dev/null; then
            ((deleted_count++))
        else
            log_warn "删除失败: $image_name"
        fi
    done < <(echo "$images_to_delete")

    log_success "清理完成，共删除 $deleted_count 个镜像。"
}

# 主函数
main() {
    local command="$1"

    case "$command" in
        "all")
            clean_all
            ;;
        "keep-latest")
            clean_keep_latest
            ;;
        "keep-daily")
            clean_keep_daily
            ;;
        "--help"|"-h"|"help")
            show_help
            ;;
        "")
            log_error "请指定清理命令。使用 --help 查看帮助。"
            exit 1
            ;;
        *)
            log_error "未知命令: $command"
            log_error "使用 --help 查看可用命令。"
            exit 1
            ;;
    esac
}

# 检查参数
if [ $# -eq 0 ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    show_help
    exit 0
fi

# 执行前检查
check_docker

# 执行主函数
main "$@"
